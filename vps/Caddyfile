{
	email admin@malice.biz
	# QUIC/UDP is unreliable or blocked on some client networks (the
	# workstation's Tailscale falls back to a DERP relay). Large HTTP/3
	# responses then die with "writing: deadline exceeded" mid-stream while
	# the same request over HTTP/2 succeeds; force HTTP/2 for streaming.
	servers {
		protocols h1 h2
	}
	# Error/runtime log. This also records the request URI on reverse-proxy
	# errors, so it needs the same credential filter as the access log:
	# Subsonic legacy auth puts the password in `p`.
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 50mb
			roll_keep 5
		}
		format filter {
			request>uri query {
				replace p REDACTED
				replace t REDACTED
				replace s REDACTED
				replace api_key REDACTED
				replace ApiKey REDACTED
				replace token REDACTED
			}
			request>headers>X-Emby-Authorization delete
			request>headers>X-Emby-Token delete
			request>headers>X-Password delete
			request>headers>X-Api-Key delete
		}
	}
}

# Credential redaction (audit VPS-3/11): Jellyfin api_key=, Navidrome p=,
# X-Emby-Authorization tokens were persisted in access.log (1318+59/24h).
# Filter BEFORE output so neither logs nor the goaccess HTML carry them.
(log_redacted) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format filter {
			request>uri query {
				replace p REDACTED
				replace t REDACTED
				replace s REDACTED
				replace api_key REDACTED
				replace ApiKey REDACTED
				replace token REDACTED
			}
			request>headers>X-Emby-Authorization delete
			request>headers>X-Emby-Token delete
			request>headers>X-Password delete
			request>headers>X-Api-Key delete
		}
	}
}

(public_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=86400"
	}
}

(public_proxy) {
	import public_headers
	import log_redacted
	reverse_proxy 10.44.0.2:{args[0]}
}

import /etc/caddy/sites/*.caddy
