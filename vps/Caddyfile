{
	email admin@malice.biz
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
}

(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
}

(public_proxy) {
	import access_log
	reverse_proxy 10.44.0.2:{args[0]}
}

import /etc/caddy/sites/*.caddy
