# chill-01 public vhosts (10.44.0.2 backends). Deployed by `make vps`.
# NOTE: multi-line blocks required — the Caddyfile `import` directive
# rejects single-line `host { ... }` blocks in imported files.
photos.malice.biz {
	import public_proxy 2283
}
files.malice.biz {
	import public_proxy 8086
}
paperless.malice.biz {
	import public_proxy 8092
}
kavita.malice.biz {
	import public_proxy 8094
}
neko.malice.biz {
	import public_proxy 8097
}
screego.malice.biz {
	# Inlined from public_proxy (same logging): screego reads only
	# X-Real-IP for client attribution, which reverse_proxy does not set
	# by default. {http.request.remote.host} is the real client IP here
	# (VPS terminates TLS, no upstream proxy).
	import log_redacted
	reverse_proxy 10.44.0.2:5050 {
		header_up X-Real-IP {http.request.remote.host}
	}
}
