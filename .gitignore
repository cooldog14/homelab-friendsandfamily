.env
.lavish/
state/
# one-off live snapshots, never track
vps/live-backup-*/
# ansible
.ansible/
*.retry
# opentofu (state and vars stay local; .terraform.lock.hcl is committed)
tofu/.terraform/
tofu/*.tfstate
tofu/*.tfstate.*
tofu/*.tfvars
tofu/.terraform.tfstate.lock.info

# diagram: generated SVG and the detailed private render are not tracked
docs/diagram/__pycache__/
docs/diagram/out/*.svg
docs/diagram/private/

# wrangler local dev secrets (local heartbeat sink URL only)
workers/wan-heartbeat/.dev.vars
workers/wan-heartbeat/.wrangler/

# Ansible control-node venv (pinned Python/ansible-core)
.venv/

# Python bytecode from the dashboard smoke/build commands
__pycache__/
*.py[cod]
