[Unit]
Description=Restic backup
After=docker.service
# Cloud backup must still run if the local restic disk is missing; backup.sh
# checks /mnt/backup only after the offsite snapshot has completed.
RequiresMountsFor=/mnt/data /mnt/fast
OnFailure=notify@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/homelab-backup
Nice=10
IOSchedulingClass=best-effort
