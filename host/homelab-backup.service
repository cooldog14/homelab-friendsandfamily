[Unit]
Description=Restic backup
After=docker.service
# /mnt/backup share wired 2026-09-28 (pve1-backup mapping + virtiofs4 on 101).
RequiresMountsFor=/mnt/data /mnt/fast /mnt/backup
OnFailure=notify@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/homelab-backup
Environment=HOME=/root XDG_CACHE_HOME=/root/.cache
Nice=10
IOSchedulingClass=best-effort
