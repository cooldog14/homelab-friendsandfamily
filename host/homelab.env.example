# Lives at /etc/homelab.env, mode 0600, never in git. restic backs up /etc, so it rides along.
RESTIC_REPOSITORY=s3:s3.eu-central.example.com/homelab
RESTIC_PASSWORD=ChangeThisLongRandomPassword
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
RESTIC_PRUNE=1
# Gotify: get the app token from gotify.1x8.me after first login.

ALERT_URL=https://gotify.1x8.me/message?token=change-me