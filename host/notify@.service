[Unit]
Description=Alert that %i failed

# Reusable: add "OnFailure=notify@%n.service" to any unit. Success stays silent.
[Service]
Type=oneshot
EnvironmentFile=/etc/homelab.env
# An empty/missing ALERT_URL must not fail silently: log it so it shows in
# the journal instead of looking like a healthy, quiet system.
ExecStart=/bin/sh -c 'curl -fsS -X POST -F "message=%i failed on %H" -F "priority=5" "${ALERT_URL:-}" >/dev/null || logger -p user.err "homelab alert delivery failed for %i"'
