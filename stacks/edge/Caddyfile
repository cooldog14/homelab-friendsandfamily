# Private vhosts, tailnet-only. ONE wildcard cert for *.h.malice.biz via DNS-01,
# so no name here needs an inbound port and public DNS needs exactly one record:
# *.h.malice.biz A <chill-01 Tailscale IP>. More specific than the existing
# *.malice.biz -> VPS wildcard, so it wins without disturbing it.
#
# Exact host routes below are THE authority for private/admin ports.
#
# Public *.malice.biz vhosts live on the VPS in vps/sites/*.caddy. Never
# duplicate one into this file: two Caddies racing for the same name means two
# ACME orders and a rate-limited afternoon.
#
{
	email admin@malice.biz
}

*.h.malice.biz {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Exact host matchers avoid map's bad unknown-host fallback; keep the 404 last.
	@files host files.h.malice.biz
	@stirling host stirling.h.malice.biz
	@gotify host gotify.h.malice.biz
	@beszel host beszel.h.malice.biz
	@cockpit host cockpit.h.malice.biz
	# Private Immich: uploads from own devices avoid hairpinning through
	# the VPS (see the port comment in stacks/photos/docker-compose.yml).
	@immich host immich.h.malice.biz
	@qbittorrent host qbittorrent.h.malice.biz
	@prowlarr host prowlarr.h.malice.biz
	@radarr host radarr.h.malice.biz
	@sonarr host sonarr.h.malice.biz
	@bazarr host bazarr.h.malice.biz
	@slskd host slskd.h.malice.biz
	@wrtag host wrtag.h.malice.biz
	@suwayomi host suwayomi.h.malice.biz
	route {
		reverse_proxy @files 10.44.0.2:8085
		reverse_proxy @stirling 10.44.0.2:8091
		reverse_proxy @gotify 10.44.0.2:8070
		reverse_proxy @beszel 10.44.0.2:8090
		reverse_proxy @cockpit https://host.docker.internal:9090 {
			transport http {
				tls_insecure_skip_verify
			}
		}
		reverse_proxy @immich 10.44.0.2:2283
		reverse_proxy @qbittorrent 10.44.0.2:8701
		reverse_proxy @prowlarr 10.44.0.2:9696
		reverse_proxy @radarr 10.44.0.2:7878
		reverse_proxy @sonarr 10.44.0.2:8989
		reverse_proxy @bazarr 10.44.0.2:6767
		reverse_proxy @slskd 10.44.0.2:5030
		reverse_proxy @wrtag 10.44.0.2:7373
		reverse_proxy @suwayomi 10.44.0.2:4567
		respond "unknown private service" 404
	}
}
