# Private vhosts, tailnet-only. ONE wildcard cert for *.h.malice.biz via DNS-01,
# so no name here needs an inbound port and public DNS needs exactly one record:
# *.h.malice.biz A <chill-01 Tailscale IP>. More specific than the existing
# *.malice.biz -> VPS wildcard, so it wins without disturbing it.
#
# Exact host routes below are THE authority for private/admin ports.
#
# Public *.malice.biz vhosts live on the VPS in vps/sites/*.caddy. Never
# duplicate one into this file: two Caddies racing for the same name means two
# ACME orders and a rate-limited afternoon.
#
{
	email admin@malice.biz
}

*.h.malice.biz {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Exact host matchers, NOT map: map leaves {svcport} unset for unknown names
	# (its `default` line is silently dropped — verified 2026-09-16), and an
	# unset placeholder makes `!= ""` true, proxying unknowns to :0 (502).
	# Extend the same way, keep the 404 last.
	@home_status {
		host home.h.malice.biz
		path /status/*
	}
	handle @home_status {
		uri strip_prefix /status
		root * /srv/status
		file_server
	}
	@home host home.h.malice.biz
	handle @home {
		root * /srv/home
		file_server
	}
	@dockge host dockge.h.malice.biz
	handle @dockge {
		reverse_proxy {env.UPSTREAM}:5001
	}
	@gotify host gotify.h.malice.biz
	handle @gotify {
		reverse_proxy {env.UPSTREAM}:8070
	}
	@beszel host beszel.h.malice.biz
	handle @beszel {
		reverse_proxy {env.UPSTREAM}:8090
	}
	@qbittorrent host qbittorrent.h.malice.biz
	handle @qbittorrent {
		reverse_proxy {env.UPSTREAM}:8701
	}
	@prowlarr host prowlarr.h.malice.biz
	handle @prowlarr {
		reverse_proxy {env.UPSTREAM}:9696
	}
	@radarr host radarr.h.malice.biz
	handle @radarr {
		reverse_proxy {env.UPSTREAM}:7878
	}
	@sonarr host sonarr.h.malice.biz
	handle @sonarr {
		reverse_proxy {env.UPSTREAM}:8989
	}
	@bazarr host bazarr.h.malice.biz
	handle @bazarr {
		reverse_proxy {env.UPSTREAM}:6767
	}
	@slskd host slskd.h.malice.biz
	handle @slskd {
		reverse_proxy {env.UPSTREAM}:5030
	}
	@wrtag host wrtag.h.malice.biz
	handle @wrtag {
		reverse_proxy {env.UPSTREAM}:7373
	}
	@suwayomi host suwayomi.h.malice.biz
	handle @suwayomi {
		reverse_proxy {env.UPSTREAM}:4567
	}
	handle {
		respond "unknown private service" 404
	}
}
