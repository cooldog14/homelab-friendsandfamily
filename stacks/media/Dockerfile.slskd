FROM slskd/slskd:0.26.0

USER root

RUN if command -v apt-get >/dev/null; then \
      apt-get update && \
      apt-get install --no-install-recommends -y ca-certificates coreutils jq wget && \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null; then \
      apk add --no-cache ca-certificates coreutils jq wget; \
    else \
      echo "no supported package manager found" >&2; exit 1; \
    fi
