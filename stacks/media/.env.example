DATA_LOCATION=/mnt/data
TIMEZONE=Europe/Paris
WG_IP=10.44.0.2

# Manual dufs accounts. admin manages, user is upload-only (delete is
# disabled globally via DUFS_ALLOW_DELETE=false).
DUFS_ADMIN_PASSWORD=change-me
DUFS_USER_PASSWORD=change-me

# Navidrome admin/Subsonic credentials. Use matching users manually; no LDAP.
SUBSONIC_ADMIN_USERNAME=change-me
SUBSONIC_ADMIN_PASSWORD=change-me

# Optional cron import notifications. Use the existing Gotify message endpoint.
GOTIFY_URL=
IMPORT_MIN_AGE_MINUTES=2
NAVIDROME_HOST=127.0.0.1:4533

# slskd credentials stay in env; do not put them in config/slskd/slskd.yml.
SLSKD_SLSK_USERNAME=change-me
SLSKD_SLSK_PASSWORD=change-me
SLSKD_API_KEY=change-me
SLSK_LISTEN_PORT=50300

# Wrtag API key used by slskd's completion hook.
WRTAG_WEB_API_KEY=change-me

# Octo-Fiesta provider. Fill only the provider you use.
MUSIC_SERVICE=Deezer
DEEZER_ARL=change-me
DEEZER_ARL_FALLBACK=
QOBUZ_USER_AUTH_TOKEN=
QOBUZ_USER_ID=
QOBUZ_QUALITY=
TIDAL_QUALITY=
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_ACCESS_TOKEN=
TIDAL_REFRESH_TOKEN=
TIDAL_USER_ID=
TIDAL_COUNTRY_CODE=
SQUIDWTF_SOURCE=Qobuz
SQUIDWTF_QUALITY=
SQUIDWTF_INSTANCE_TIMEOUT=5
YANDEX_OAUTH_TOKEN=
YANDEX_QUALITY=
YANDEX_LANGUAGE=
YANDEX_INCLUDE_UNAVAILABLE_TRACKS=false
