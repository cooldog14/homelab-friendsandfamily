DATA_LOCATION=/mnt/data
TIMEZONE=Europe/Paris
WG_IP=10.44.0.2

# Navidrome admin/Subsonic credentials. Use matching users manually; no LDAP.
SUBSONIC_ADMIN_USERNAME=change-me
SUBSONIC_ADMIN_PASSWORD=change-me

# Optional cron import notifications. Use the existing Gotify message endpoint.
GOTIFY_URL=
IMPORT_MIN_AGE_MINUTES=2
NAVIDROME_HOST=127.0.0.1:4533

# slskd credentials stay in env; do not put them in config/slskd/slskd.yml.
SLSKD_SLSK_USERNAME=change-me
SLSKD_SLSK_PASSWORD=change-me
SLSKD_API_KEY=change-me
SLSK_LISTEN_PORT=50300

# Wrtag API key used by slskd's completion hook.
WRTAG_WEB_API_KEY=change-me

# Octo-Fiesta Deezer token.
DEEZER_ARL=change-me
