DATA_LOCATION=/mnt/data
TIMEZONE=Europe/Paris
WG_IP=10.44.0.2

# Navidrome admin/Subsonic credentials. Use matching users manually; no LDAP.
SUBSONIC_ADMIN_USERNAME=change-me
SUBSONIC_ADMIN_PASSWORD=change-me

# Gluetun VPN egress for qbittorrent/prowlarr/flaresolverr/slskd.
# Copy the values from the arr LXC /opt/arr/.env. Never commit .env.
WIREGUARD_PRIVATE_KEY=change-me
WIREGUARD_ADDRESSES=change-me
VPN_ENDPOINT_IP=change-me
VPN_ENDPOINT_PORT=change-me
VPS_WG_PUBKEY=change-me
FIREWALL_VPN_INPUT_PORTS=6881,50300

# slskd credentials stay in env; do not put them in config/slskd/slskd.yml.
SLSKD_SLSK_USERNAME=change-me
SLSKD_SLSK_PASSWORD=change-me
SLSKD_API_KEY=change-me

# Wrtag API key used by slskd's completion hook.
WRTAG_WEB_API_KEY=change-me

# Suwayomi native UI login.
SUWAYOMI_AUTH_USERNAME=change-me
SUWAYOMI_AUTH_PASSWORD=change-me

# Octo-Fiesta music provider.
DEEZER_ARL=change-me
DEEZER_ARL_FALLBACK=
