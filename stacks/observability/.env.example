# Beszel prints this public key after first login; add the system as host.docker.internal:45876.
BESZEL_KEY=change-me
# Seeds Gotify's initial admin only; if live auth drifted, back up state first,
# then reset app DB/API state. Editing .env alone will not change it.
GOTIFY_DEFAULTUSER_PASS=change-me
# Grafana admin login (no sign-up, no anonymous access).
GRAFANA_ADMIN_PASSWORD=change-me
# Gotify application token used by the Alertmanager -> Gotify bridge. Create the
# app once in the Gotify UI, then paste the token here (host-only .env).
GOTIFY_ALERTMANAGER_TOKEN=change-me
